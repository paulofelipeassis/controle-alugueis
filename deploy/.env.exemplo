# Copie para deploy/.env NO SERVIDOR e preencha. Nunca commitar o .env.

# Pastas do servidor
PASTA_DADOS=/opt/controle-alugueis/dados
PASTA_DOCUMENTOS=/home/documentos

# Endereço do sistema (o domínio, ou o endereço do servidor até ter domínio)
DOMINIO=srv2001369.hstgr.cloud

# Traefik e Hermes: descobrir no servidor com `docker network ls` e
# `docker inspect` (ver docs/instalacao-servidor.md). Não adivinhar.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
HERMES_REDE=hermes-agent-1uy1_default

# Segredos: gere com `openssl rand -hex 32`, direto no servidor.
SESSION_SECRET=
MCP_TOKEN=

# Primeira competência cobrada pelo sistema (AAAA-MM). Decidido com o Paulo: novembro de 2026
# (outubro fecha no sistema antigo, sem cobrança em dobro).
INICIO_COBRANCAS=2026-11

# 1 = o site é acessado por HTTPS (é o caso no servidor): o cookie de login só viaja por conexão segura.
# Se o login "não gruda" (volta para a tela de entrada), confira se está entrando por https://.
COOKIE_SEGURO=1

# Feriados municipais, separados por vírgula: MM-DD (todo ano) ou AAAA-MM-DD. Os nacionais, o Carnaval,
# a Sexta-feira Santa, o Corpus Christi e o 31/12 (sem expediente bancário) já estão no sistema.
# Vencimento em fim de semana ou feriado vale até o dia útil seguinte.
# Formosa-GO (Câmara Municipal): 01/08 Data Magna do município, 30/11 Dia do Evangélico
# (Lei 562/12, alterada pela Lei 233/15), 08/12 Nossa Senhora da Imaculada Conceição (Lei 193/03).
# O 15/08 (N. Sra. D'Abadia) é data comemorativa, não feriado.
FERIADOS_EXTRAS=08-01,11-30,12-08

# Backup no Google Drive (ver docs/instalacao-servidor.md). Vazio = só local.
RCLONE_DESTINO=
BACKUP_MANTER=14
BACKUP_HORA=3
