# Copie para deploy/.env NO SERVIDOR e preencha. Nunca commitar o .env.

# Pastas do servidor
PASTA_DADOS=/opt/controle-alugueis/dados
PASTA_DOCUMENTOS=/home/documentos

# Endereço do sistema (o domínio, ou o endereço do servidor até ter domínio)
DOMINIO=srv2001369.hstgr.cloud

# Traefik e Hermes: descobrir no servidor com `docker network ls` e
# `docker inspect` (ver docs/instalacao-servidor.md). Não adivinhar.
TRAEFIK_REDE=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=
HERMES_REDE=

# Segredos: gere com `openssl rand -hex 32`, direto no servidor.
SESSION_SECRET=
MCP_TOKEN=

# Primeira competência cobrada pelo sistema (AAAA-MM). Definir com o Paulo.
INICIO_COBRANCAS=2026-10

# 1 = o site é acessado por HTTPS (é o caso no servidor): o cookie de login só viaja por conexão segura.
# Se o login "não gruda" (volta para a tela de entrada), confira se está entrando por https://.
COOKIE_SEGURO=1

# Feriados que o sistema não conhece (municipais, dias sem expediente bancário), separados por vírgula:
# MM-DD (todo ano) ou AAAA-MM-DD. Os nacionais, o Carnaval, a Sexta-feira Santa e o Corpus Christi
# já estão no sistema. Vencimento em fim de semana ou feriado vale até o dia útil seguinte.
# Ex. para Goiânia: 10-24 (aniversário da cidade). Confirme com o banco se 12-31 também vale.
FERIADOS_EXTRAS=

# Backup no Google Drive (ver docs/instalacao-servidor.md). Vazio = só local.
RCLONE_DESTINO=
BACKUP_MANTER=14
BACKUP_HORA=3
